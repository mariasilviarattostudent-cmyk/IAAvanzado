    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const actual = $json;\nconst historial = Array.isArray($json.historial) ? $json.historial : [];\nconst fechaActual = actual.fecha;\nconst anteriores = historial.filter(r => r.fecha && r.fecha < fechaActual).sort((a,b) => String(b.fecha).localeCompare(String(a.fecha)));\nconst fechaExistente = historial.some(r => r.fecha === fechaActual);\nconst ultimosTres = anteriores.slice(0,3);\nconst anterior = anteriores[0];\nlet variacionPct = null;\nif (!fechaExistente && anterior && Number(anterior.valor_venta) > 0) { variacionPct = ((Number(actual.valor_venta)-Number(anterior.valor_venta))/Number(anterior.valor_venta))*100; }\nreturn { json: { fecha: actual.fecha, valor_compra: Number(actual.valor_compra), valor_venta: Number(actual.valor_venta), fecha_existente: fechaExistente, ultimos_tres: ultimosTres, venta_anterior: anterior ? Number(anterior.valor_venta) : null, variacion_pct: variacionPct, alerta_suba: variacionPct !== null && variacionPct >= 10 } };"
      },
      "id": "b5f70b59-6a62-4973-8c47-f2a176de6b05",
      "name": "Code - Validar y comparar",
